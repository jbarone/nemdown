build/
compile_commands.json
*.o
*.d

# Core dumps. valgrind names its own vgcore.PID, which `core` does not
# match -- a 140MB dump from a crash test was committed before this line
# existed.
core
vgcore.*
*.core

# Generated test asset (regenerated by test/run.sh)

# makepkg's working directories, its downloaded source and its output. Same
# lesson as the core dump above: one `git add -A` after a package build and a
# 140KB tarball plus two packages are in the history for good.
packaging/aur/*/src/
packaging/aur/*/pkg/
packaging/aur/nemdown-git/nemdown-git/
packaging/aur/*/*.pkg.tar.zst
packaging/aur/*/*.tar.gz
