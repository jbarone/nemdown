pkgbase = nemdown-git
	pkgdesc = Native Wayland markdown viewer with Obsidian-style rendering and typeset maths (git)
	pkgver = 0.r0.0000000
	pkgrel = 1
	url = https://github.com/jbarone/nemdown
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = clang
	makedepends = wayland-protocols
	makedepends = pkgconf
	depends = glibc
	depends = wayland
	depends = libxkbcommon
	depends = cairo
	depends = pango
	depends = md4c
	depends = libyaml
	depends = gdk-pixbuf2
	depends = librsvg
	depends = glib2
	depends = harfbuzz
	optdepends = wl-clipboard: copying selected text and code fences
	optdepends = otf-stix: typeset maths (any font with an OpenType MATH table works)
	optdepends = otf-latinmodern-math: typeset maths, Computer Modern instead of STIX
	optdepends = ttf-hack-nerd: the font the typography is designed around
	provides = nemdown
	conflicts = nemdown
	source = nemdown-git::git+https://github.com/jbarone/nemdown.git
	sha256sums = SKIP

pkgname = nemdown-git
