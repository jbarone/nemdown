# Maintainer: Joshua Barone <joshua@bar1security.com>
#
# Builds from the tip of the repository. Use the `nemdown` package instead if
# you would rather track tagged releases.

pkgname=nemdown-git
pkgver=0.r0.0000000
pkgrel=1
pkgdesc='Native Wayland markdown viewer with Obsidian-style rendering and typeset maths (git)'
arch=('x86_64')
url='https://github.com/jbarone/nemdown'
license=('MIT')

# glib2 and harfbuzz are linked directly -- glib for its UTF-8 and casefolding
# helpers, harfbuzz for the OpenType MATH table the maths typesetter reads --
# so they are listed even though pango would pull both in anyway.
depends=('glibc' 'wayland' 'libxkbcommon' 'cairo' 'pango' 'md4c' 'libyaml'
         'gdk-pixbuf2' 'librsvg' 'glib2' 'harfbuzz')
makedepends=('git' 'clang' 'wayland-protocols' 'pkgconf')
optdepends=('wl-clipboard: copying selected text and code fences'
            'otf-stix: typeset maths (any font with an OpenType MATH table works)'
            'otf-latinmodern-math: typeset maths, Computer Modern instead of STIX'
            'graphviz: draw mermaid flowchart, state and class diagrams'
            'ttf-hack-nerd: the font the typography is designed around')
provides=('nemdown')
conflicts=('nemdown')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # An if, not `describe || printf`: the fallback has to hang off the describe
  # itself, because in a pipeline the || binds to the LAST command. With no
  # tags yet, describe fails, sed succeeds on empty input, and makepkg refuses
  # the empty version it is handed.
  local tag
  if tag=$(git describe --long --tags 2>/dev/null); then
    printf '%s' "$tag" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    # Commit count first so it sorts correctly, and keeps sorting correctly
    # once tags arrive and the branch above takes over.
    printf '0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cd "$pkgname"
  # The Makefile appends CFLAGS/CPPFLAGS/LDFLAGS from the environment, so
  # makepkg's hardening, LTO and debug flags all apply here.
  make release
}

check() {
  cd "$pkgname"
  # Headless: no compositor is involved. Runs the two assertion harnesses,
  # which fail the build, then parses every fixture.
  make test
}

package() {
  cd "$pkgname"
  # LICENSEDIR follows the PACKAGE name: namcap requires the MIT text under
  # /usr/share/licenses/$pkgname, which differs from the project name here.
  make PREFIX=/usr LICENSEDIR="/usr/share/licenses/$pkgname" \
       DESTDIR="$pkgdir" install
}
