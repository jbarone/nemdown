pkgbase = nemdown
	pkgdesc = Native Wayland markdown viewer with Obsidian-style rendering and typeset maths
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/CHANGEME/nemdown
	arch = x86_64
	license = MIT
	makedepends = clang
	makedepends = wayland-protocols
	makedepends = pkgconf
	depends = glibc
	depends = wayland
	depends = libxkbcommon
	depends = cairo
	depends = pango
	depends = md4c
	depends = libyaml
	depends = gdk-pixbuf2
	depends = librsvg
	depends = glib2
	depends = harfbuzz
	optdepends = wl-clipboard: copying selected text and code fences
	optdepends = otf-stix: typeset maths (any font with an OpenType MATH table works)
	optdepends = otf-latinmodern-math: typeset maths, Computer Modern instead of STIX
	optdepends = ttf-hack-nerd: the font the typography is designed around
	source = nemdown-0.1.0.tar.gz::https://github.com/CHANGEME/nemdown/archive/refs/tags/v0.1.0.tar.gz
	sha256sums = SKIP

pkgname = nemdown
