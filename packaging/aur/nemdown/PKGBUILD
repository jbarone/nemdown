# Maintainer: Joshua Barone <joshua@bar1security.com>
#
# Tracks tagged releases. Use `nemdown-git` to build from the repository tip.
#
# ON EVERY RELEASE: bump pkgver, then run `updpkgsums` and regenerate .SRCINFO.
# The checksum can only be computed once the tag exists, because it is over the
# tarball GitHub generates from it -- so the sum for a release always lands in
# a commit AFTER the tag it describes. A published PKGBUILD still carrying SKIP
# is one nobody can verify, which is the whole point of shipping a checksum.

pkgname=nemdown
pkgver=0.1.0
pkgrel=1
pkgdesc='Native Wayland markdown viewer: Obsidian rendering, typeset maths, mermaid'
arch=('x86_64')
url='https://github.com/jbarone/nemdown'
license=('MIT')

depends=('glibc' 'wayland' 'libxkbcommon' 'cairo' 'pango' 'md4c' 'libyaml'
         'gdk-pixbuf2' 'librsvg' 'glib2' 'harfbuzz')
makedepends=('clang' 'wayland-protocols' 'pkgconf')
# Only for check(): check_mermaid exercises the graph dialects through graphviz,
# and without it those cases would silently be skipped rather than tested.
checkdepends=('graphviz')
optdepends=('wl-clipboard: copying selected text and code fences'
            'otf-stix: typeset maths (any font with an OpenType MATH table works)'
            'otf-latinmodern-math: typeset maths, Computer Modern instead of STIX'
            'graphviz: draw mermaid flowchart, state and class diagrams'
            'ttf-hack-nerd: the font the typography is designed around')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('038576bd7cdfff39e2c695ee9e7fbdfa98a741dfac6f81b6bc3388bcb9e56812')

build() {
  cd "$pkgname-$pkgver"
  make release
}

check() {
  cd "$pkgname-$pkgver"
  make test
}

package() {
  cd "$pkgname-$pkgver"
  # LICENSEDIR follows the PACKAGE name: namcap requires the MIT text under
  # /usr/share/licenses/$pkgname, which differs from the project name here.
  make PREFIX=/usr LICENSEDIR="/usr/share/licenses/$pkgname" \
       DESTDIR="$pkgdir" install
}
